{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Babos",
  "version": "0.1.6",
  "identifier": "com.shihbo.worklog",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "node -e \"const f=require('fs');f.mkdirSync('dist',{recursive:true});f.copyFileSync('app.html','dist/index.html')\"",
    "beforeDevCommand": "node -e \"const f=require('fs');f.mkdirSync('dist',{recursive:true});f.copyFileSync('app.html','dist/index.html')\""
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Babos",
        "width": 1440,
        "height": 900,
        "minWidth": 1080,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    }
  }
}
